# ---- Public (inlined into the browser bundle at build time) ----

# Public URL of this site (used for metadata, sitemap, robots, OG image)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public contact address shown on the site
NEXT_PUBLIC_CONTACT_EMAIL=kareemniazi47@gmail.com

# Social links: leave empty to hide the icon entirely
NEXT_PUBLIC_GITHUB_URL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_GITLAB_URL=

# Resume: place the PDF at public/Kareem-Ullah-Resume.pdf (or point this elsewhere).
# The Download button only renders when this variable is set to a real file.
NEXT_PUBLIC_RESUME_URL=

# Optional: Google Search Console verification token (the content value of the meta tag)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ---- SERVER-ONLY (read by app/api/contact/route.ts; never prefix with NEXT_PUBLIC_) ----
# All four of SMTP_HOST, SMTP_USER, SMTP_PASS and CONTACT_TO_EMAIL are required for the contact form to work.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465 (SMTP_SECURE=true) or 587, and SMTP_PASS must be an App Password.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# Where contact notifications are delivered
CONTACT_TO_EMAIL=
# Optional sender, e.g. Portfolio <you@example.com>. Defaults to SMTP_USER.
MAIL_FROM=
